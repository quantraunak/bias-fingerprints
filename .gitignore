# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store

# Downloaded and derived data. Everything here is rebuilt by the scripts in
# project/scripts (see README "Reproduce"), so none of it belongs in the repository.
project/data/
*.parquet

# Run outputs. docs/index.html is generated from these and is committed;
